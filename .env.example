# Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-...

# LM Studio / Anthropic Base URL
ANTHROPIC_BASE_URL=http://127.0.0.1:1234

# MCP Server Keys
# Figma: personal access token (figd_...) — used by figma-developer-mcp stdio server
FIGMA_MCP_KEY=figd_...
# Naos: remote HTTP endpoint (no auth required, defaults to https://naos-mcp.51b.dev/mcp)
# NAOS_MCP_URL=https://naos-mcp.51b.dev/mcp

# Project Configuration
PROJECT_ROOT=/path/to/your/project

# Optional: Claude Model (or local model via LM Studio)
# For multi-agent pipeline, recommended: qwen3-coder:30b
CLAUDE_MODEL=claude-sonnet-4-20250514

# Optional: Agent Configuration
MAX_TURNS=30
MIN_COVERAGE=80
VERBOSE=false

# Multi-Agent Pipeline (Planner → Coder → Reviewer → Fixer)
# Set to true to enable 4-stage pipeline for improved code quality
# Requires qwen3-coder:30b or similar model in LM Studio
USE_MULTI_AGENT_PIPELINE=false
